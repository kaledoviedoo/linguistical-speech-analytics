  "description": "Auditor local de framing causal en discursos politicos y economicos. 100% offline, sin nube, sin APIs de pago.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
